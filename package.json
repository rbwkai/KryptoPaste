{
  "name": "kryptopaste",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w server",
    "start": "npm start -w server",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm test --ws --if-present",
    "db:test:up": "docker start kp-test-mongo || docker run -d --name kp-test-mongo -p 127.0.0.1:27018:27017 mongo:7",
    "db:test:down": "docker rm -f kp-test-mongo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
